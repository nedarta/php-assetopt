{
    "name": "nedarta/cssmin",
    "description": "A PHP port of the YUI CSS compressor",
    "keywords": ["yui", "compressor", "css", "cssmin", "compress", "minify"],
    "homepage": "https://github.com/nedarta/cssmin",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Túbal Martín",
            "homepage": "http://tubalmartin.me/"
        },
        {
            "name": "Edgars Karlsons",
            "email": "edgars.karlsons@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/nedarta/cssmin/issues",
        "source": "https://github.com/nedarta/cssmin"
    },
    "autoload": {
        "psr-4": {
            "nedarta\\CssMin\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "nedarta\\CssMin\\Tests\\": "tests"
        }
    },
    "bin": [
        "cssmin"
    ],
    "require": {
        "php": ">=8.2",
        "ext-pcre": "*"
    },
    "require-dev": {
        "cogpowered/finediff": "0.3.*",
        "phpunit/phpunit": "^9"
    }
}