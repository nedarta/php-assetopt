{
    "name": "nedarta/php-assetopt",
    "description": "PHP asset optimizer: a clean port of the YUI CSS compressor plus a whitespace/comment stripper for JavaScript",
    "keywords": ["compress", "minify", "css", "javascript", "assets", "optimizer"],
    "homepage": "https://github.com/nedarta/php-assetopt",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Túbal Martín",
            "homepage": "http://tubalmartin.me/"
        },
        {
            "name": "Edgars Karlsons",
            "email": "edgars.karlsons@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/nedarta/php-assetopt/issues",
        "source": "https://github.com/nedarta/php-assetopt"
    },
    "autoload": {
        "psr-4": {
            "nedarta\\AssetOpt\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "nedarta\\AssetOpt\\Tests\\": "tests"
        }
    },
    "bin": [
        "assetopt"
    ],
    "require": {
        "php": ">=8.2",
        "ext-pcre": "*"
    },
    "require-dev": {
        "cogpowered/finediff": "0.3.*",
        "phpunit/phpunit": "^9"
    }
}
